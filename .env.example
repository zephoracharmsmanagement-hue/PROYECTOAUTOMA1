# =============================================================================
#  AUTOMA - Plataforma de paquetes SaaS para Ecommerce
#  Copia este archivo a `.env.local` y rellena los valores.
#  NUNCA commitees `.env.local`. Las claves marcadas [SECRETO] jamas deben
#  exponerse al cliente (no usar prefijo NEXT_PUBLIC_ con ellas).
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# URL publica canonica. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SUPABASE  (https://supabase.com/dashboard -> Project Settings -> API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# [SECRETO] Bypassa RLS. Solo se usa en el webhook de Stripe y tareas de servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# STRIPE  (https://dashboard.stripe.com/apikeys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# [SECRETO]
STRIPE_SECRET_KEY=sk_test_...
# [SECRETO] Se obtiene con `stripe listen` (local) o al crear el endpoint (prod).
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# BUNNY STREAM  (https://dash.bunny.net -> Stream -> Library)
# -----------------------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=123456
# [SECRETO] Clave de autenticacion de la libreria: firma los tokens de embed.
BUNNY_STREAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Minutos de validez del token de reproduccion firmado.
BUNNY_TOKEN_TTL_MINUTES=180

# -----------------------------------------------------------------------------
# OPCIONALES
# -----------------------------------------------------------------------------
# Email transaccional (Resend). Si esta vacio, los envios se loguean y no fallan.
RESEND_API_KEY=
EMAIL_FROM=Automa <no-reply@tudominio.com>
