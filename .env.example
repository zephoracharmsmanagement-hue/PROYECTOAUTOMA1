# =============================================================================
#  AUTOMA - Plataforma de paquetes SaaS para Ecommerce
#  Copia este archivo a `.env.local` y rellena los valores.
#  NUNCA commitees `.env.local`. Las claves marcadas [SECRETO] jamas deben
#  exponerse al cliente (no usar prefijo NEXT_PUBLIC_ con ellas).
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# URL publica canonica. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SUPABASE  (https://supabase.com/dashboard -> Project Settings -> API)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# [SECRETO] Bypassa RLS. Solo se usa en el webhook de Stripe y tareas de servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# STRIPE  (https://dashboard.stripe.com/apikeys)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# [SECRETO]
STRIPE_SECRET_KEY=sk_test_...
# [SECRETO] Se obtiene con `stripe listen` (local) o al crear el endpoint (prod).
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# BUNNY STREAM  (https://dash.bunny.net -> Stream -> Library)
# -----------------------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=123456
# [SECRETO] Clave de autenticacion de la libreria: firma los tokens de embed.
BUNNY_STREAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Minutos de validez del token de reproduccion firmado.
BUNNY_TOKEN_TTL_MINUTES=180

# -----------------------------------------------------------------------------
# EMAIL TRANSACCIONAL  (https://resend.com/api-keys)
#
# Si RESEND_API_KEY o EMAIL_FROM estan vacios, los envios se registran en el log
# y no fallan: se puede desarrollar y desplegar previews sin credenciales.
# El dominio de EMAIL_FROM debe estar verificado en Resend (SPF + DKIM).
# -----------------------------------------------------------------------------
# [SECRETO]
RESEND_API_KEY=
EMAIL_FROM=Automa <no-reply@tudominio.com>
# Direccion a la que responde el cliente si contesta al email. Opcional.
EMAIL_REPLY_TO=soporte@tudominio.com

# -----------------------------------------------------------------------------
# ANALITICA
#
# 'none' (por defecto) desactiva el envio de eventos por completo.
# 'plausible' no usa cookies ni datos personales: no requiere banner de consentimiento.
# 'ga4' SI lo requiere en la UE; si lo activas, anade tu gestor de consentimiento.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# Solo con provider=plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tudominio.com
# Solo si autoalojas Plausible. Por defecto: https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Solo con provider=ga4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
